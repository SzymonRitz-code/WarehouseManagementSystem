{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SeedingEnabled": false,
  "Seeding": {
    "Enabled": false,
    "Profile": "Extreme",
    "Profiles": {
      "Demo": {
        "MasterData": {
          "ProductCount": 200,
          "WarehouseCount": 2,
          "ZonesPerWarehouse": 5,
          "AverageBatchesPerTrackedProduct": 3,
          "AverageStockRowsPerProduct": 3,
          "Seed": 42
        },
        "OperationalData": {
          "MovementItemCount": 1000,
          "AverageItemsPerDocument": 4,
          "SaveDocumentBatchSize": 500,
          "Seed": 42
        }
      },
      "Medium": {
        "MasterData": {
          "ProductCount": 3000,
          "WarehouseCount": 3,
          "ZonesPerWarehouse": 10,
          "AverageBatchesPerTrackedProduct": 5,
          "AverageStockRowsPerProduct": 8,
          "Seed": 42
        },
        "OperationalData": {
          "MovementItemCount": 20000,
          "AverageItemsPerDocument": 5,
          "SaveDocumentBatchSize": 2000,
          "Seed": 42
        }
      },
      "Stress": {
        "MasterData": {
          "ProductCount": 12000,
          "WarehouseCount": 4,
          "ZonesPerWarehouse": 15,
          "AverageBatchesPerTrackedProduct": 8,
          "AverageStockRowsPerProduct": 12,
          "Seed": 42
        },
        "OperationalData": {
          "MovementItemCount": 500000,
          "AverageItemsPerDocument": 5,
          "SaveDocumentBatchSize": 5000,
          "Seed": 42
        }
      },
      "Extreme": {
        "MasterData": {
          "ProductCount": 12000,
          "WarehouseCount": 3,
          "ZonesPerWarehouse": 12,
          "AverageBatchesPerTrackedProduct": 6,
          "AverageStockRowsPerProduct": 8,
          "Seed": 42
        },
        "OperationalData": {
          "MovementItemCount": 10000000,
          "AverageItemsPerDocument": 5,
          "SaveDocumentBatchSize": 5000,
          "Seed": 42
        }
      }
    }
  },
  "Authentication": {
    "Authority": "https://localhost:44380",
    "Audience": "wmsApi",
    "RequireHttpsMetadata": true
  },
  // Sql server: localhost,14333
  // Login: sa
  // Password: Wms_dev_password123!
  "ConnectionStrings": {
    "WarehouseManagementSystemConnection": "Server=localhost,14333;Database=WarehouseDb;User Id=sa;Password=Wms_dev_password123!;TrustServerCertificate=True;"
  },
  "RedisCache": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstancePrefix": "wms",
    "DefaultTtlMinutes": 15,
    "NegativeTtlSeconds": 30,
    "TtlJitterSeconds": 30,
    "ConnectTimeoutMs": 2000,
    "OperationTimeoutMs": 1500
  },
  "Messaging": {
    "Enabled": true,
    "PublishBatchSize": 20,
    "PublishPollIntervalSeconds": 5,
    "PublishConfirmTimeoutSeconds": 10,
    "MaxPublishAttempts": 3,
    "PublishRetryDelaySeconds": 30,
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/"
    },
    "Exchanges": {
      "WmsEvents": "wms.events",
      "DeadLetter": "wms.events.dlx"
    },
    "Shipping": {
      "DocumentConfirmedQueue": "shipping.document-confirmed",
      "DocumentConfirmedDeadLetterQueue": "shipping.document-confirmed.dlq",
      "DocumentConfirmedRetryQueue": "shipping.document-confirmed.retry",
      "DocumentConfirmedRetryExchange": "wms.events.retry",
      "DocumentConfirmedRoutingKey": "document.confirmed",
      "PrefetchCount": 10,
      "MaxRetryAttempts": 3,
      "RetryDelaySeconds": 10
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/wms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
