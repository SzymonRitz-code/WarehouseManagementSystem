{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RedisCache": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstancePrefix": "wms-dev",
